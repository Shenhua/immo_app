# app_immo Environment Configuration
# Copy this file to .env and adjust values as needed

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOGLEVEL=INFO

# Maximum extra apport percentage per property (0.0-1.0)
# Read by the allocator (src/application/services/allocator.py) to prevent full loan payoff at t=0.
# Code default when unset: 0.95.
MAX_EXTRA_APPORT_PCT=0.95

# Optional: directory for app.log (default: <repo>/logs)
# APP_LOG_DIR=/path/to/logs
